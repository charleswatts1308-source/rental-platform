APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=mg.renters.rent
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=

# LLCS outbound From + inbound reply domain. REQUIRED, no default: CaseNotice throws
# if either is missing, so every environment (production included) must set both
# explicitly — this prevents a misconfigured env from silently sending a
# production-shaped identity through the wrong domain.
# Production:
#   MAILGUN_CASES_FROM_ADDRESS=cases@mg.renters.rent
#   MAILGUN_INBOUND_DOMAIN=inbox.renters.rent
# Staging-on-sandbox: use a "sandbox@" local part so a stray test email is obviously
# non-production, and point inbound at the sandbox subdomain. NOTE: the Mailgun sandbox
# has NO inbound route, so landlord-reply round-tripping is production-only (dev:reply
# still works on staging — it injects the inbound webhook in-process).
#   MAILGUN_CASES_FROM_ADDRESS=sandbox@sandbox0d486079544b4512bc37ae6162e60036.mailgun.org
#   MAILGUN_INBOUND_DOMAIN=sandbox0d486079544b4512bc37ae6162e60036.mailgun.org
MAILGUN_CASES_FROM_ADDRESS=
MAILGUN_INBOUND_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
